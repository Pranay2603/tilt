# Used by the API (npm run dev:api). Defaults match docker-compose.yml.
DATABASE_URL=postgres://tilt:tilt@localhost:5433/tilt
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=tilt
# Set to false to run the queue worker as a separate process.
RUN_WORKER=true
PORT=3000
# Used by API tests.
TEST_DATABASE_URL=postgres://tilt:tilt@localhost:5433/tilt_test
TEST_REDIS_URL=redis://localhost:6380
